{
  "entryPoints": [
    "packages/*"
  ],
  "projectDocuments": [
    "README.md",
    "docs/get-started.md",
    "docs/guide.md",
    "docs/message-passing.md",
    "docs/spackle.md",
    "docs/reference.md",
    "docs/lockdown.md",
    "docs/errors.md",
    "docs/bugs.md"
  ],
  "categoryOrder": [
    "Guides",
    "Reference",
    "*",
    "Annex"
  ],
  "exclude": [
    "**/tmp/**",
    "**/dist/**",
    "**/dist-xs/**",
    "**/node_modules/**",
    "packages/chacha12-fast-check-test",
    "packages/chat",
    "packages/spaces-util",
    "packages/space-peers",
    "packages/cjs-module-analyzer",
    "packages/cli",
    "packages/compartment-mapper",
    "packages/conversation-tree",
    "packages/daemon",
    "packages/demo",
    "packages/evasive-transform",
    "packages/eventual-send-test",
    "packages/fae",
    "packages/familiar",
    "packages/genie",
    "packages/harden-test",
    "packages/hex-test",
    "packages/space-chat",
    "packages/space-inventory-graph",
    "packages/ses-test",
    "packages/jaine",
    "packages/hardened262",
    "packages/lal",
    "packages/memoize",
    "packages/module-source",
    "packages/netstring",
    "packages/ocapn",
    "packages/ocapn-noise",
    "packages/platform",
    "packages/preact-container",
    "packages/relay-server",
    "packages/skel",
    "packages/stream-types-test",
    "packages/syrup",
    "packages/test262-runner/",
    "packages/where",
    "packages/space-whylip",
    "packages/monaco-wrapper",
    "packages/space-file-explorer",
    "api-docs/"
  ],
  "plugin": [
    "typedoc-plugin-mermaid"
  ],
  "name": "Endo",
  "titleLink": "https://endojs.org",
  "entryPointStrategy": "packages",
  "customCss": "docs/assets/custom.css",
  "useTsLinkResolution": true,
  "tsconfig": "./tsconfig.json",
  "out": "api-docs",
  "includeVersion": true
}

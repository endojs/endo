{
  "extends": "../../tsconfig.eslint-base.json",
  "files": [
    "index.js",
    "shim.js"
  ],
  "include": [
    "*.js",
    "*.ts",
    "scripts/*.js",
    "src/*.js",
    "src/*.ts",
    "src-xs/*.js",

{
  "name": "@endo/pubsub",
  "version": "0.1.0",
  "private": true,
  "description": "Local pubsub topics over a shared async promise linked list",
  "keywords": [
    "endo",
    "pubsub",
    "topic",
    "stream",
    "async",
    "iterator"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/pubsub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/pubsub"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    "./change-topic.js": {
      "types": "./change-topic.d.ts",
      "default": "./change-topic.js"
    },
    "./latest-topic.js": {
      "types": "./latest-topic.d.ts",
      "default": "./latest-topic.js"
    },
    "./pub-sub.js": {
      "types": "./pub-sub.d.ts",
      "default": "./pub-sub.js"
    },
    "./null-queue.js": {
      "types": "./null-queue.d.ts",
      "default": "./null-queue.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "prepack": "git clean -fX -e node_modules/ && tsc --build tsconfig.build.json",
    "postpack": "git clean -fX -e node_modules/",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "eslint --fix .",
    "lint:eslint": "eslint .",
    "lint:types": "tsc",
    "test": "ses-ava",
    "test:c8": "c8 ${C8_OPTIONS:-} ses-ava"
  },
  "dependencies": {
    "@endo/eventual-send": "workspace:^",
    "@endo/harden": "workspace:^",
    "@endo/promise-kit": "workspace:^",
    "@endo/stream": "workspace:^",
    "ses": "workspace:^"
  },
  "devDependencies": {
    "@endo/cancel": "workspace:^",
    "@endo/init": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "c8": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "dist",
    "lib",
    "src",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sesAvaConfigs": {
    "lockdown": "../../ava-endo-lockdown.config.mjs",
    "unsafe": "../../ava-endo-lockdown-unsafe.config.mjs",
    "endo": "../../ava-endo-shims-only.config.mjs"
  }
}

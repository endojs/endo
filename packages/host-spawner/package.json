{
  "name": "@endo/host-spawner",
  "version": "0.0.0",
  "private": true,
  "description": "The host-side `Spawner` seam: `makeHostSpawner` wraps `child_process.spawn` behind a single `spawn(argv, opts) -> ProcessLike` contract whose async-iterable stdio mirrors `@endo/sandbox`'s DriverProcess, so a host engine and a sandbox slice engine are interchangeable. Extracted from @endo/genie so daemon-side capabilities (e.g. the Shell formula) can reach it without depending on the agent framework.",
  "keywords": [
    "endo",
    "spawn",
    "subprocess",
    "shell"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/host-spawner"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types-index.d.ts",
  "exports": {
    ".": {
      "types": "./types-index.d.ts",
      "default": "./src/index.js"
    },
    "./src/host-spawner.js": {
      "types": "./src/host-spawner.d.ts",
      "default": "./src/host-spawner.js"
    },
    "./types-index.js": {
      "types": "./types-index.d.ts",
      "default": "./types-index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "test": "ava",
    "lint": "yarn lint:types && yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'",
    "lint:types": "tsc"
  },
  "dependencies": {
    "@endo/harden": "workspace:^"
  },
  "devDependencies": {
    "@endo/init": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "60s"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  }
}

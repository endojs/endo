{
  "name": "@endo/bash",
  "version": "0.0.0",
  "private": true,
  "description": "Unconfined Endo formula that runs a shell command with `bash -c`, exposing its stdin / stdout / stderr as exo-stream byte streams and resolving its exit status.  Platform-specific (requires a POSIX `bash`); pair with the daemon's `make-unconfined` formula type.",
  "keywords": [
    "endo",
    "exo",
    "bash",
    "stream",
    "subprocess"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/bash"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./src/index.js"
    },
    "./src/bash-process.js": {
      "types": "./types.d.ts",
      "default": "./src/bash-process.js"
    },
    "./src/interfaces.js": {
      "types": "./types.d.ts",
      "default": "./src/interfaces.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "test": "ava --serial",
    "lint": "yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'"
  },
  "dependencies": {
    "@endo/errors": "workspace:^",
    "@endo/eventual-send": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/exo-stream": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/promise-kit": "workspace:^",
    "@endo/stream-node": "workspace:^"
  },
  "devDependencies": {
    "@endo/daemon": "workspace:^",
    "@endo/init": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "120s"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  }
}

{
  "name": "@endo/host-shell",
  "version": "0.0.0",
  "private": true,
  "description": "Unconfined Endo formula that runs a single host command and surfaces its stdin / stdout / stderr as exo-stream byte streams plus an exit status.  Defaults to a structured argv (no shell, no injection); shell interpretation is opt-in.  Platform-specific (spawns a host subprocess); pair with the daemon's `make-unconfined` formula type.",
  "keywords": [
    "endo",
    "exo",
    "shell",
    "stream",
    "subprocess"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/host-shell"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/shell-process.js": "./src/shell-process.js",
    "./src/interfaces.js": "./src/interfaces.js",
    "./src/types.js": "./src/types.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "test": "ava --serial",
    "lint": "yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'"
  },
  "dependencies": {
    "@endo/errors": "workspace:^",
    "@endo/eventual-send": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/exo-stream": "workspace:^",
    "@endo/patterns": "workspace:^",
    "@endo/promise-kit": "workspace:^",
    "@endo/stream-node": "workspace:^"
  },
  "devDependencies": {
    "@endo/daemon": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/init": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "120s"
  }
}

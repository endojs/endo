{
  "name": "@endo/cbor",
  "version": "0.1.0",
  "description": "Canonical CBOR primitives for one item",
  "keywords": [
    "cbor",
    "canonical",
    "rfc8949",
    "codec",
    "deterministic"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/cbor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/cbor"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:eslint",
    "lint:eslint": "eslint .",
    "test": "ses-ava"
  },
  "dependencies": {

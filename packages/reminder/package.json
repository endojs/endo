{
  "name": "@endo/reminder",
  "version": "0.0.0",
  "private": true,
  "description": "Unconfined Endo plugin that schedules messages. A reminder service produces messages on various schedules (start-to-start periods) and nothing else; policy about what to do on a schedule belongs to the recipient. Durable tracking lives on the platform virtual file system, so the backing may be a real directory, a database, or memory. Provision it through the daemon's generic `make-unconfined` pathway and pin it into `@pins` for wake-on-restart.",
  "keywords": [
    "endo",
    "exo",
    "reminder",
    "scheduler",
    "message-scheduler",
    "plugin"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/reminder"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/scheduler.js": "./src/scheduler.js",
    "./src/store.js": "./src/store.js",
    "./src/backoff.js": "./src/backoff.js",
    "./src/interfaces.js": "./src/interfaces.js",
    "./src/types.js": "./src/types.d.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "test": "ava --serial",
    "lint": "yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'"
  },
  "dependencies": {
    "@endo/eventual-send": "workspace:^",
    "@endo/exo": "workspace:^",
    "@endo/pass-style": "workspace:^",
    "@endo/patterns": "workspace:^"
  },
  "devDependencies": {
    "@endo/init": "workspace:^",
    "@endo/platform": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "120s"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  }
}

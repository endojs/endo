{
  "name": "@endo/spaces-util",
  "version": "0.1.0",
  "private": true,
  "description": "Shared message-rendering primitives for Endo Chat spaces (markdown/value vnodes, time formatting, chime, locator helpers)",
  "keywords": [
    "endo",
    "chat",
    "markdown",
    "preact"
  ],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/spaces-util"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./markdown-render.js": "./src/markdown-render.js",
    "./markdown-vnodes.js": "./src/markdown-vnodes.js",
    "./value-vnodes.js": "./src/value-vnodes.js",
    "./value-component.js": "./src/value-component.js",
    "./value-render.js": "./src/value-render.js",
    "./language-detect.js": "./src/language-detect.js",
    "./markdown-preview.js": "./src/markdown-preview.js",
    "./time-formatters.js": "./src/time-formatters.js",
    "./chime.js": "./src/chime.js",
    "./locator.js": "./src/locator.js",
    "./package.json": "./package.json",
    "./token-autocomplete.js": "./src/token-autocomplete.js"
  },
  "scripts": {
    "build": "exit 0",

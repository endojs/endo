    "lint:eslint": "eslint '**/*.js'"
  },
  "dependencies": {
    "@endo/daemon": "workspace:^",
    "@endo/far": "workspace:^",
    "@endo/harden": "workspace:^",
    "@endo/markmdown": "workspace:^",
    "@endo/monaco-wrapper": "workspace:^",
    "@endo/pass-style": "workspace:^",
    "@endo/preact-container": "workspace:^",
    "marked": "^17.0.5",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "eslint": "catalog:dev"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
